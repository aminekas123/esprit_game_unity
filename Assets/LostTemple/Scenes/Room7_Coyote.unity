  m_EditorClassIdentifier: Assembly-CSharp::LostTemple.PhotoPuzzle
  objective: Accomplissez les 3 missions photo du Coyote
  tutorial: "\xAB Je suis l'esprit Coyote, gardien de l'artefact. Pour gagner ma cl\xE9, rapporte-moi trois images du monde des vivants. \xBB\n\nLa cam\xE9ra du t\xE9l\xE9phone s'ouvre : photographiez dans la vraie vie un objet de la couleur demand\xE9e, bien au centre du cadre dor\xE9.\n\nLes photos sont analys\xE9es sur le t\xE9l\xE9phone puis oubli\xE9es : rien n'est enregistr\xE9."
  hint: "Approchez-vous d'un objet de la bonne couleur pour qu'il remplisse le cadre dor\xE9, avec assez de lumi\xE8re."
  sensor: 6
  usesSensor: 1
  fxAnchor: {fileID: 1233200618}
  cameraPose: {fileID: 1550156567}
  coyote: {fileID: 482178044}
  targets: 000000000100000004000000i
  fragments:
  - KA
  - YO
  - "T\xC9"
  requiredShare: 0.3
