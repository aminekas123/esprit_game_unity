  m_Script: {fileID: 11500000, guid: 5cfb2e20adef44671b9aa47af4339704, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LostTemple.SpeakSentencePuzzle
  objective: "Lisez \xE0 voix haute la phrase en anglais"
  tutorial: "Une phrase en ANGLAIS appara\xEEt sur la plaque. Lisez-la \xE0 voix haute, clairement, pr\xE8s du micro du t\xE9l\xE9phone.\n\nSur le t\xE9l\xE9phone, la reconnaissance vocale v\xE9rifie les mots prononc\xE9s (au moins 70 % de bons mots). Si elle ne comprend pas, elle vous r\xE9\xE9coute.\n\nQuand la phrase est reconnue, la porte s'ouvre."
  hint: "Parlez lentement et articulez chaque mot. Approchez le bas du t\xE9l\xE9phone de votre bouche."
  sensor: 3
  usesSensor: 1
  fxAnchor: {fileID: 1679037015}
  cameraPose: {fileID: 727741924}
  plaque: {fileID: 1679037013}
  plaqueRenderer: {fileID: 1943463688}
  requiredMatch: 0.7
