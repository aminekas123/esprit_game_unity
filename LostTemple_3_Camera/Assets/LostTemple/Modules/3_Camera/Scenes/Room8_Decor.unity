  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LostTemple.DecorScanPuzzle
  objective: "D\xE9corez la salle avec les couleurs de votre monde"
  tutorial: "Voici la salle de d\xE9coration.\n\nScannez avec la cam\xE9ra du t\xE9l\xE9phone un objet de la vraie vie : sa couleur appara\xEEt aussit\xF4t comme un objet dans la salle.\n\nScannez autant de couleurs que vous voulez, puis touchez \xAB Terminer \xBB pour ouvrir la porte.\n\nLes photos sont analys\xE9es sur le t\xE9l\xE9phone puis oubli\xE9es : rien n'est enregistr\xE9."
  hint: "Approchez-vous d'un objet bien color\xE9 pour qu'il remplisse le cadre dor\xE9, avec assez de lumi\xE8re."
  sensor: 6
  usesSensor: 1
  skipTutorial: 0
  fxAnchor: {fileID: 1854341939}
  cameraPose: {fileID: 0}
  spawner: {fileID: 2100766511}
  requiredShare: 0.3
